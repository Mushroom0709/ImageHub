# OBS 对象存储
OBS_ENDPOINT=your-obs-endpoint
OBS_ACCESS_KEY=your-access-key
OBS_SECRET_KEY=your-secret-key
OBS_BUCKET=your-bucket-name
OBS_PREFIX=ImageHub/

# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=imagehub
POSTGRES_PASSWORD=change_me
POSTGRES_DB=imagehub

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=change_me

# AI 大模型
AI_API_BASE=http://your-ai-endpoint/v1
AI_API_KEY=your-api-key
AI_MODEL=/model

# TikHub
TIKHUB_TOKEN=your-tikhub-token
TIKHUB_BASE_URL=https://api.tikhub.dev

# JWT
JWT_SECRET=change_me_to_a_random_string

# 上传
# 单文件大小上限（字节），默认 2GB
UPLOAD_MAX_FILE_SIZE=2147483648
# 分片大小（字节），默认 8MB
UPLOAD_CHUNK_SIZE=8388608
# 超过该大小自动走分片上传（字节），默认 100MB
UPLOAD_MULTIPART_THRESHOLD=104857600
# 上传/处理临时文件目录（建议挂载物理盘，避免容器 tmpfs 占内存）
UPLOAD_TMP_DIR=/data/imagehub-tmp

# 应用
APP_PORT=8000
APP_ENV=production
